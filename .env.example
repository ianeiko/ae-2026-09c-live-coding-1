# Copy to .env and fill in the three keys. .env is gitignored — never commit real
# keys, and never paste a value into a Claude chat.
# These seven vars are the whole contract: the Agent, the Judges and the eval
# script all read them from this one file at the repo root.

# TypeSafe (Jev). Handed to you — early access, no self-signup.
TYPESAFE_API_KEY=ts-...

# https://openrouter.ai/keys — handed to you, already topped up.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any slug from https://openrouter.ai/models, copied exactly. Used by both the
# Agent and the LLM Judge. A wrong slug fails at request time, not at startup.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# LangSmith. Your own key: https://smith.langchain.com -> Settings -> API keys.
LANGSMITH_API_KEY=lsv2_pt_...
# Sends Agent runs and Jev calls to LangSmith as traces.
LANGCHAIN_TRACING_V2=true
# Fixed for the cohort, so every learner's project looks the same during review.
LANGSMITH_PROJECT=interview-coach-09c
